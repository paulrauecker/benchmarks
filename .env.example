# OpenRouter
OPENROUTER_API_KEY=sk-or-v1-...

# Self-hosted vLLM / SGLang  (registry: openai-api/homelab/<model>)
HOMELAB_BASE_URL=http://your-box:8000/v1
HOMELAB_API_KEY=local

# Self-hosted llama.cpp llama-server  (registry: openai-api/llamacpp/<model>)
# Launch flags matter -- see the `server:` block in models.yaml and note that
# effective context per slot = --ctx-size / --parallel.
LLAMACPP_BASE_URL=http://your-box:8080/v1
LLAMACPP_API_KEY=local

# A second llama.cpp box, if you run more than one  (registry: openai-api/proteus/<model>)
PROTEUS_BASE_URL=http://your-other-box:8080/v1
PROTEUS_API_KEY=local

# Required only for gated HF datasets -- currently just gpqa_diamond
# (Idavidrein/gpqa). Accept the dataset's terms at
# https://huggingface.co/datasets/Idavidrein/gpqa first, then generate a
# read token at https://huggingface.co/settings/tokens.
HF_TOKEN=hf_...
